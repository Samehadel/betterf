# Copy to .env and set a local-only password before starting.
DB_USER=postgres
DB_PASSWORD=
DB_PORT=5432
DB_URL=jdbc:postgresql://127.0.0.1:5432/betterf
SERVER_PORT=8080
BACKEND_URL=http://127.0.0.1:8080

# Local HTTP development only. Production keeps secure cookies enabled.
SESSION_COOKIE_SECURE=false
PUBLIC_ORIGIN=http://127.0.0.1:4200
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# The local Mailpit relay uses neither authentication nor STARTTLS.
SMTP_AUTH=false
SMTP_STARTTLS=false
MAILPIT_PORT=8025
MAIL_FROM=no-reply@betterf.local

# Default cap includes active administrators; pending invitations do not count.
INVITATION_MAX_ACTIVE_ACCOUNTS=10

# Absolute refresh lifetime; rotation does not extend it.
REFRESH_TOKEN_LIFETIME=14d
